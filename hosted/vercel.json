{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {"excludeFiles": "app/**", "maxDuration": 60}
  },
  "rewrites": [
    {"source": "/api/reading/status", "destination": "/api/reading"},
    {"source": "/api/music/audio", "destination": "/api/music"}
  ],
  "headers": [
    {"source": "/app/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
